# CampSolver frontend environment variables
# Copy to .env and fill with your own values. Never commit real values.

# Student App API (Express backend)
VITE_API_BASE_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001

# Supabase client (optional — Realtime subscriptions)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
